{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connected repositories",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "ref", "stage", "index", "feeds", "reads"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "ref": { "type": "string", "minLength": 1 },
          "stage": { "type": "string" },
          "index": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Markdown folders or files to search, relative to the repo root" },
          "feeds": { "type": "array", "items": { "type": "string" } },
          "reads": { "type": "array", "items": { "type": "string" } },
          "readme": {
            "type": "object",
            "description": "The short row for the README's \"How it connects\" table (generated by scripts/Update-BrainDocs.ps1)",
            "required": ["stage", "gives", "takes"],
            "additionalProperties": false,
            "properties": { "stage": { "type": "string" }, "gives": { "type": "string" }, "takes": { "type": "string" } }
          }
        }
      }
    }
  }
}
