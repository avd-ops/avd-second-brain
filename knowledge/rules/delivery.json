{
  "$schema": "../schemas/rule.schema.json",
  "id": "delivery",
  "title": "App delivery decision table",
  "status": "active",
  "version": 1,
  "usedBy": "Stage 4 app rationalization",
  "values": {
    "order": [
      { "when": "unused-in-window", "delivery": "retire" },
      { "when": "hardware-bound", "delivery": "stays-physical", "note": "Or a redirection test in the pilot" },
      { "when": "not-multi-session-compatible", "delivery": "personal", "note": "Or remediate" },
      { "when": "web-or-saas", "delivery": "web", "note": "Check SSO and Conditional Access" },
      { "when": "persona-share-above", "threshold": 0.8, "andStable": true, "delivery": "image" },
      { "when": "persona-specific-or-frequent-updates", "andMsixable": true, "delivery": "app-attach" },
      { "when": "few-users-across-many-personas", "delivery": "remote-app" }
    ]
  },
  "sources": ["docs/factory-spec.md#62-application-rationalization"],
  "history": [
    { "version": 1, "date": "2026-10-16", "change": "Seeded from the factory spec's delivery table, in the order it is evaluated.", "reason": "Phase 1 of the second brain" }
  ]
}
