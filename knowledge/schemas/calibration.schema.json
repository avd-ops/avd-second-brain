{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sizing calibration observations",
  "type": "object",
  "required": ["observations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engagement", "wave", "tier", "vmSize", "vmFamily", "predictedSessionsPerHost", "measuredSessionsPerHost", "measuredOn"],
        "additionalProperties": false,
        "properties": {
          "engagement": { "type": "string", "pattern": "^eng-[0-9]{4}-[0-9]{2}-[a-z0-9]{4}$" },
          "wave": { "type": "integer", "minimum": 0 },
          "tier": { "enum": ["light", "medium", "heavy", "power", "gpu"] },
          "vmSize": { "type": "string", "pattern": "^Standard_[A-Za-z0-9_]+$" },
          "vmFamily": { "type": "string", "pattern": "^[A-Z]{1,3}$", "description": "D, E, F, NV, NC..." },
          "predictedSessionsPerHost": { "type": "number", "exclusiveMinimum": 0 },
          "measuredSessionsPerHost": { "type": "number", "exclusiveMinimum": 0, "description": "Sessions per host at the calibration rule's target utilization" },
          "boundBy": { "enum": ["cpu", "memory", "guidance", "gpu", "storage"] },
          "source": { "enum": ["factory-verify", "landing-zone-brain"] },
          "measuredOn": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
