{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App catalog",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "vendor", "product", "majorVersion", "match", "category", "scope", "multiSession", "source", "evidence", "lastVerified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9.x-]+$" },
          "vendor": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "majorVersion": { "type": "string", "minLength": 1 },
          "match": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
          "category": { "enum": ["m365", "saas-web", "win32", "runtime", "legacy", "gpu", "hardware-bound", "per-device-licensed", "ad-dependent"] },
          "scope": { "enum": ["public-product", "customer-lob"] },
          "multiSession": { "enum": ["works", "needs-fix", "blocked", "unknown"] },
          "delivery": { "enum": ["image", "app-attach", "remote-app", "web", "personal", "stays-physical", "retire", null] },
          "notes": { "type": "string" },
          "source": { "enum": ["person", "rule", "llm", "pilot"] },
          "llm": {
            "type": "object",
            "required": ["model", "promptVersion", "date"],
            "additionalProperties": false,
            "properties": {
              "model": { "type": "string" },
              "promptVersion": { "type": "string" },
              "date": { "type": "string", "format": "date" }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "ref", "date"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["doc", "pilot", "engagement"] },
                "ref": { "type": "string", "minLength": 1, "description": "doc: an https URL. pilot and engagement: an engagement ID." },
                "outcome": { "enum": ["works", "needs-fix", "blocked"] },
                "summary": { "type": "string" },
                "date": { "type": "string", "format": "date" }
              }
            }
          },
          "reviewedBy": { "type": "string" },
          "lastVerified": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
