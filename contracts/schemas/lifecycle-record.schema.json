{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "avd-lifecycle-record/v1: why one AVD environment is built and performs the way it does",
  "description": "Contract C18. One record per environment, from its birth onwards: the use cases it serves, the decisions made about it (what was chosen, what else was considered and why not, what drove it, the evidence), and the change events that carried them out across build, configure, expand, contract, fix, recover and retire. avd-swarm records the how (plans and their outcomes, C10) and the brain keeps the why here. Pseudonymous like C14: it lives in the estate vault (lifecycle/<environment>.json) and never in knowledge/. No field holds a tenant, subscription, group or object ID, a user, a machine, an address or free text beyond short notes that harvests drop.",
  "type": "object",
  "required": ["schema", "estate", "environment", "born", "generatedUtc", "pins", "useCases", "decisions", "events"],
  "additionalProperties": false,
  "$defs": {
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "useCaseId": { "type": "string", "pattern": "^uc-[0-9]{2,3}$" },
    "decisionId": { "type": "string", "pattern": "^dec-[0-9]{4}$" },
    "eventId": { "type": "string", "pattern": "^evt-[0-9]{4,6}$" },
    "subject": {
      "type": "string",
      "pattern": "^((hp|st|sub|env)-[0-9a-f]{8}|tp-[0-9]{2}|persona-[0-9]{1,3})$",
      "description": "C11/C12 pseudonyms (hp-, st-, sub-), the environment (env-), C14 target pools (tp-NN) and personas"
    },
    "factRef": {
      "type": "string",
      "pattern": "^(c11|c12|intake|liquidware)\\.[A-Za-z0-9.]{2,80}(@((hp|st|sub)-[0-9a-f]{8}|tp-[0-9]{2}|persona-[0-9]{1,3}))?$",
      "description": "<factId> or <factId>@<subject>; factId must be in the fact register (C15)"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^((c11|c12|intake|liquidware)\\.[A-Za-z0-9.]{2,80}(@((hp|st|sub)-[0-9a-f]{8}|tp-[0-9]{2}|persona-[0-9]{1,3}))?|rule:[a-z0-9-]{2,40}@v[0-9]{1,4}|manifest:[0-9a-f]{12}#[A-Za-z.]{2,40}|run:run-[0-9]{8}-[0-9]{4}-[a-z0-9]{4}|plan:[A-Za-z0-9-]{6,64}|doc:[a-z0-9-]{2,60}@[0-9a-f]{7,40}:[A-Za-z0-9._/-]{2,200}|adr:ADR-[0-9]{4}|evt-[0-9]{4,6})$",
      "description": "A fact (C15), a rule (knowledge/rules, rule:<id>@v<n>), a C14 manifest decision (manifest:<first 12 hex of its SHA-256>#<register decision>), a C17 run (run:<runId>), an avd-swarm plan (plan:<planId>), a public doc at a commit (doc:<repo>@<commit>:<path>, as C7 cites), the vault's own ADR (adr:ADR-NNNN, where the full text with names lives) or an earlier event"
    },
    "note": {
      "type": "string",
      "pattern": "^(?!.*//)[A-Za-z0-9 .,:;()/+=%*-]{0,200}$",
      "description": "Dropped by harvests; never a name, an ID or a link"
    },
    "scalar": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9 ._:+=%-]{1,80}$" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "value": {
      "description": "A public value: an Azure size, region or setting, a count, a catalog ID, or a few of them together",
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$" },
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      ]
    },
    "reason": {
      "enum": ["cost", "performance", "user-experience", "capacity", "risk", "security", "compliance", "policy", "supportability", "complexity", "customer-requirement", "timing", "not-recorded", "other"]
    },
    "useCase": {
      "type": "object",
      "required": ["id", "kind", "tier", "users", "status", "since"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/useCaseId" },
        "kind": {
          "enum": ["knowledge-worker", "task-worker", "developer", "power-user", "graphics", "call-center", "contractor", "remote-app", "education", "test-dev", "disaster-recovery", "other"]
        },
        "tier": { "enum": ["light", "medium", "heavy", "power", "gpu"] },
        "users": { "enum": ["1-10", "11-50", "51-200", "201-1000", ">1000"], "description": "A bucket, never a count of named people" },
        "persona": { "type": "string", "pattern": "^persona-[0-9]{1,3}$" },
        "hostPools": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/subject" } },
        "apps": { "type": "array", "maxItems": 40, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/._-]{1,80}$" }, "description": "knowledge/catalog/apps.json IDs (public products), never names" },
        "status": { "enum": ["planned", "active", "retired"] },
        "since": { "$ref": "#/$defs/date" },
        "until": { "$ref": "#/$defs/date" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "alternative": {
      "type": "object",
      "required": ["value", "whyNot"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/value" },
        "whyNot": { "$ref": "#/$defs/reason" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "date", "phase", "topic", "chosen", "drivers", "evidence", "status", "source", "decidedBy"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/decisionId" },
        "date": { "$ref": "#/$defs/date" },
        "phase": { "enum": ["assess", "design", "build", "configure", "expand", "contract", "fix", "recover", "retire", "operate"] },
        "topic": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z]{1,30}(\\.[a-zA-Z]{2,30})?$",
          "description": "A fact register decision (C15, such as hostPool.vmSize) or one of the lifecycle topics (Test-LifecycleRecord lists them)"
        },
        "subjects": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/subject" } },
        "useCases": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/useCaseId" } },
        "chosen": { "$ref": "#/$defs/value" },
        "alternatives": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/alternative" } },
        "drivers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["use-case", "evidence", "rule", "incident", "lesson", "cost", "performance", "user-experience", "capacity", "risk", "security", "compliance", "policy", "supportability", "customer-requirement", "timing", "other"]
          }
        },
        "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/evidenceRef" } },
        "confidence": { "enum": ["high", "medium", "low"] },
        "watch": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/factRef" },
          "description": "Facts whose change reopens this decision (Get-LifecycleReview)"
        },
        "reviewBy": { "$ref": "#/$defs/date" },
        "status": { "enum": ["proposed", "accepted", "superseded", "reverted", "rejected"] },
        "supersedes": { "$ref": "#/$defs/decisionId" },
        "source": { "enum": ["target-state", "operator", "swarm-plan", "brain-proposal", "adr"] },
        "decidedBy": { "enum": ["owner", "operator", "approver", "factory-rule", "other"], "description": "A role, never a person; who approved is in the vault's Git history or the plan store" },
        "note": { "$ref": "#/$defs/note" }
      }
    },
    "change": {
      "type": "object",
      "required": ["fact"],
      "additionalProperties": false,
      "properties": {
        "fact": { "$ref": "#/$defs/factRef" },
        "before": { "$ref": "#/$defs/value" },
        "after": { "$ref": "#/$defs/value" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "utc", "kind", "actor", "outcome"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/eventId" },
        "utc": { "$ref": "#/$defs/utc" },
        "kind": { "enum": ["born", "build", "configure", "expand", "contract", "fix", "recover", "retire", "drift", "incident", "review"] },
        "decisions": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/decisionId" }, "description": "The decisions this event carries out: the why" },
        "useCases": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/useCaseId" } },
        "subjects": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/subject" } },
        "maps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "pattern": "^(tp-[0-9]{2}|persona-[0-9]{1,3})$" },
              "to": { "type": "string", "pattern": "^(hp|st)-[0-9a-f]{8}$" }
            }
          },
          "description": "Which deployed resource a design subject became, so design decisions follow it"
        },
        "actor": { "enum": ["landing-zone-run", "swarm-plan", "operator", "scaling-plan", "azure-platform", "unknown"] },
        "run": { "type": "string", "pattern": "^run-[0-9]{8}-[0-9]{4}-[a-z0-9]{4}$", "description": "The C17 run that did it" },
        "plan": { "type": "string", "pattern": "^[A-Za-z0-9-]{6,64}$", "description": "The avd-swarm plan that did it (its C10 outcome)" },
        "outcome": { "enum": ["verified", "failed", "rolled-back", "rejected", "partial", "observed"] },
        "change": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/change" } },
        "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/evidenceRef" } },
        "note": { "$ref": "#/$defs/note" }
      }
    }
  },
  "properties": {
    "schema": { "const": "avd-lifecycle-record/v1" },
    "estate": { "type": "string", "pattern": "^est-[0-9a-f]{8}$" },
    "environment": { "type": "string", "pattern": "^env-[0-9a-f]{8}$", "description": "HMAC pseudonym over the environment's resource group or subscription, keyed with the estate's resources subkey (C11)" },
    "engagement": { "type": "string", "pattern": "^eng-[0-9]{4}-[0-9]{2}-[a-z0-9]{4}$" },
    "born": { "$ref": "#/$defs/date" },
    "generatedUtc": { "$ref": "#/$defs/utc" },
    "pins": {
      "type": "object",
      "required": ["factRegister"],
      "additionalProperties": false,
      "properties": {
        "factRegister": { "type": "integer", "minimum": 1 },
        "brainCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "useCases": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/useCase" } },
    "decisions": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/decision" } },
    "events": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/event" } }
  }
}
