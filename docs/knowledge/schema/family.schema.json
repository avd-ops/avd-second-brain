{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family.schema.json",
  "title": "Family of sibling knowledge bases",
  "description": "Every KB that shares this format, this one included. Placeholder rows keep <angle brackets> until the sibling is set up.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kbs"
  ],
  "properties": {
    "kbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repo",
          "path",
          "focus",
          "format_version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "repo": {
            "type": "string",
            "pattern": "^(<[^>]+>|[A-Za-z0-9-]+)/(<[^>]+>|[A-Za-z0-9._-]+)$",
            "description": "owner/repo, or a <placeholder>."
          },
          "path": {
            "type": "string",
            "pattern": "^([A-Za-z0-9._/-]+|<[^>]+>)$",
            "description": "KB folder in that repo, no leading or trailing slash."
          },
          "focus": {
            "type": "string",
            "minLength": 3
          },
          "format_version": {
            "type": "integer",
            "minimum": 1,
            "description": "The family format version that KB follows."
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ],
            "description": "Private siblings can't be watched with the built-in GITHUB_TOKEN."
          }
        }
      }
    }
  }
}
